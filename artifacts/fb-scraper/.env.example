# Facebook Scraper Environment Variables
# Copy this to .env and fill in the values

# OpenAI API key for LLM-powered listing parsing
OPENAI_API_KEY=sk-proj-...

# PostgreSQL connection string (auto-provided in Replit)
DATABASE_URL=postgresql://...

# Path to Facebook session cookies JSON file
# Export using "EditThisCookie" or "Cookie-Editor" browser extension while logged into Facebook
FB_COOKIES_PATH=./fb_cookies.json

# The Facebook group URL to scrape (defaults to Car Dealers Ghana)
FB_GROUP_URL=https://www.facebook.com/groups/cardealersghana/

# Base URL for serving scraped images (set to your deployment URL)
PUBLIC_BASE_URL=https://your-replit-domain.repl.co

# Playwright Chromium executable path (Nix-installed chromium)
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/nix/store/qa9cnw4v5xkxyip6mb9kxqfq1z4x2dx1-chromium-138.0.7204.100/bin/chromium
