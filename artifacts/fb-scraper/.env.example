# ─────────────────────────────────────────────────────────────
# VOOM Facebook Scraper — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Required: PostgreSQL connection string (shared with api-server)
DATABASE_URL=postgresql://user:password@localhost:5432/voom

# Required: OpenAI API key for LLM-based car data parsing
OPENAI_API_KEY=sk-...

# Required: HTTP port for the scraper service
PORT=3001

# ─── Facebook Session ─────────────────────────────────────────
# Path to the JSON file containing your Facebook session cookies.
# Generate this file by:
#   1. Log in to Facebook in Chrome
#   2. Install the "EditThisCookie" or "Cookie-Editor" extension
#   3. Export cookies for facebook.com as JSON
#   4. Save the file and set this path
FB_COOKIES_PATH=./fb_cookies.json

# ─── Scraper Configuration ────────────────────────────────────
# Cron schedule for automatic scraping (default: every 6 hours)
# Format: second minute hour day month weekday
SCRAPER_CRON_SCHEDULE=0 0 */6 * * *

# Secret key to protect the /scraper/trigger HTTP endpoint
# Must match SCRAPER_API_KEY in the api-server .env
SCRAPER_API_KEY=change-me-to-a-secure-random-string

# ─── Image Storage ────────────────────────────────────────────
# Directory to save downloaded car images
IMAGES_DIR=./public/scraped-images

# Base URL used to generate public image URLs
# Should match the URL where the api-server serves static files
PUBLIC_BASE_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────
# Allowed origin for the scraper service API (usually the api-server URL)
CORS_ORIGIN=http://localhost:3000

# ─── Forwarding (api-server side) ────────────────────────────
# Set these in the api-server .env so it can proxy to the scraper service
# SCRAPER_SERVICE_URL=http://localhost:3001
# SCRAPER_API_KEY=change-me-to-a-secure-random-string
